# =============================================================================
# ViP Yemen - Android Keystore Configuration
# =============================================================================
# 
# Copy this file to keystore.properties and fill in your values
# NEVER commit keystore.properties to version control!
# Add keystore.properties to .gitignore
#
# =============================================================================

# Path to the keystore file (relative to the project root)
storeFile=vipyemen-release.jks

# Keystore password
storePassword=YOUR_KEYSTORE_PASSWORD

# Key alias in the keystore
keyAlias=vipyemen

# Key password
keyPassword=YOUR_KEY_PASSWORD

# =============================================================================
# HOW TO GENERATE A KEYSTORE
# =============================================================================
#
# 1. Generate a new keystore:
#    keytool -genkey -v -keystore vipyemen-release.jks -keyalg RSA -keysize 2048 -validity 10000 -alias vipyemen
#
# 2. Verify the keystore:
#    keytool -list -v -keystore vipyemen-release.jks
#
# 3. Export the certificate for upload to Google Play:
#    keytool -exportcert -alias vipyemen -keystore vipyemen-release.jks -file vipyemen-cert.pem
#
# =============================================================================
